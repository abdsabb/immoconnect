@startuml schema_bdd
title Schéma de base de données — ImmoConnect (MySQL, 22 tables)
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName Arial
skinparam linetype ortho
hide circle
hide empty methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1B3A4B
}

entity utilisateur {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(80)
  * prenom : VARCHAR(80)
  * email : VARCHAR(190) <<UQ>>
  * mot_de_passe : VARCHAR(255) «bcrypt»
  * langue_id : INT <<FK>>
  o photo_url : VARCHAR(255)
  * date_inscription : DATE
  * role : ENUM
  * actif : BOOLEAN
  * email_verifie : BOOLEAN
  * double_facteur : BOOLEAN
  * echecs_connexion : TINYINT
  o verrouille_jusqu_a : DATETIME
  o cgu_acceptees_le : DATETIME
  * consentement_communications : BOOLEAN
}

entity membre {
  * utilisateur_id : INT <<PK, FK>>
  --
  o telephone : VARCHAR(20)
}

entity agent_immobilier {
  * utilisateur_id : INT <<PK, FK>>
  --
  * matricule : VARCHAR(20) <<UQ>>
  * telephone_pro : VARCHAR(20)
}

entity administrateur {
  * utilisateur_id : INT <<PK, FK>>
  --
  * niveau_acces : TINYINT
}

entity langue {
  * id : INT <<PK>>
  --
  * code : CHAR(2) <<UQ>>
  * nom : VARCHAR(40)
}

entity traduction {
  * id : INT <<PK>>
  --
  * langue_id : INT <<FK>>
  * cle : VARCHAR(120)
  * valeur : TEXT
}

entity journal_audit {
  * id : INT <<PK>>
  --
  * utilisateur_id : INT <<FK>>
  * action : VARCHAR(60)
  * entite : VARCHAR(60)
  * horodatage : DATETIME
  * ip : VARCHAR(45)
}

entity jeton {
  * id : INT <<PK>>
  --
  * utilisateur_id : INT <<FK, cascade>>
  * type : ENUM
  * empreinte : CHAR(64) <<UQ>>
  o empreinte_code : CHAR(64)
  * essais : TINYINT
  * cree_le : DATETIME
  * expire_le : DATETIME
  o utilise_le : DATETIME
  * ip : VARCHAR(45)
}

entity alerte_securite {
  * id : INT <<PK>>
  --
  * type : ENUM
  * ip : VARCHAR(45)
  * detail : VARCHAR(255)
  * cree_le : DATETIME
}

entity parametre {
  * cle : VARCHAR(60) <<PK>>
  --
  * valeur : VARCHAR(1000)
  * modifie_le : DATETIME
  o modifie_par : INT <<FK>>
}

entity categorie {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(60) <<UQ>>
  o description : TEXT
}

entity bien {
  * id : INT <<PK>>
  --
  * agent_id : INT <<FK>>
  * categorie_id : INT <<FK>>
  * type_offre : ENUM
  * titre : VARCHAR(150)
  * description : TEXT
  * prix : DECIMAL(12,2)
  * superficie : DECIMAL(8,2)
  * nb_chambres : TINYINT
  * peb : ENUM
  * adresse : VARCHAR(150)
  * ville : VARCHAR(80)
  * code_postal : VARCHAR(10)
  * latitude : DECIMAL(9,6)
  * longitude : DECIMAL(9,6)
  * statut : ENUM
  * publie_le : DATE
  * nb_vues : INT
}

entity photo {
  * id : INT <<PK>>
  --
  * bien_id : INT <<FK, cascade>>
  * url : VARCHAR(255)
  * ordre : TINYINT
  o legende : VARCHAR(150)
}

entity favori {
  * membre_id : INT <<PK, FK>>
  * bien_id : INT <<PK, FK>>
  --
  * date_ajout : DATETIME
}

entity message {
  * id : INT <<PK>>
  --
  * membre_id : INT <<FK>>
  * agent_id : INT <<FK>>
  * expediteur : ENUM
  * contenu : TEXT
  * envoye_le : DATETIME
  * lu : BOOLEAN
}

entity disponibilite {
  * id : INT <<PK>>
  --
  * agent_id : INT <<FK, cascade>>
  * debut : DATETIME
  * fin : DATETIME
  * cree_le : DATETIME
}

entity rendez_vous {
  * id : INT <<PK>>
  --
  * membre_id : INT <<FK>>
  * agent_id : INT <<FK>>
  * bien_id : INT <<FK>>
  * date_heure : DATETIME
  * statut : ENUM
  o motif : VARCHAR(255)
}

entity paiement {
  * id : INT <<PK>>
  --
  * rendez_vous_id : INT <<FK, UQ>>
  * membre_id : INT <<FK>>
  * stripe_payment_intent_id : VARCHAR(120) <<UQ>>
  * montant : DECIMAL(8,2)
  * statut : ENUM
  o paye_le : DATETIME
}

entity article {
  * id : INT <<PK>>
  --
  * administrateur_id : INT <<FK>>
  * categorie_article_id : INT <<FK>>
  * titre : VARCHAR(150)
  * contenu : TEXT
  o image_url : VARCHAR(255)
  * statut : ENUM
  o publie_le : DATE
}

entity categorie_article {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(60) <<UQ>>
}

entity cle_api {
  * id : INT <<PK>>
  --
  * administrateur_id : INT <<FK>>
  * cle : VARCHAR(64) <<UQ>> «empreinte»
  o libelle : VARCHAR(80)
  * cree_le : DATE
  * active : BOOLEAN
  o derniere_utilisation : DATETIME
}

entity demande_contact {
  * id : INT <<PK>>
  --
  * nom : VARCHAR(100)
  * email : VARCHAR(150)
  o telephone : VARCHAR(30)
  * sujet : VARCHAR(150)
  * message : TEXT
  * cree_le : DATETIME
  * ip : VARCHAR(45)
  o traite_le : DATETIME
  o traite_par : INT <<FK>>
}

' — Héritage (spécialisation 1-1)
utilisateur ||--o| membre
utilisateur ||--o| agent_immobilier
utilisateur ||--o| administrateur

' — Transversal
langue ||--o{ utilisateur
langue ||--o{ traduction
utilisateur ||--o{ journal_audit
utilisateur ||--o{ jeton
administrateur |o--o{ parametre

' — Biens
agent_immobilier ||--o{ bien
categorie ||--o{ bien
bien ||--|{ photo
membre ||--o{ favori
bien ||--o{ favori

' — Interactions
membre ||--o{ message
agent_immobilier ||--o{ message
agent_immobilier ||--o{ disponibilite
membre ||--o{ rendez_vous
agent_immobilier ||--o{ rendez_vous
bien ||--o{ rendez_vous
rendez_vous ||--o| paiement
membre ||--o{ paiement

' — Blog, API et contact
administrateur ||--o{ article
categorie_article ||--o{ article
administrateur ||--o{ cle_api
administrateur |o--o{ demande_contact

legend bottom
  Notation « patte d'oie » — RA6 : un bien publié possède au moins une photo (contrainte applicative).
  Lien rendez_vous—paiement [1-0..1] : clé étrangère unique, au plus un paiement par rendez-vous.
  disponibilite : plages ouvertes par l'agent ; un rendez-vous n'est accepté que dans une de ces plages (RA15).
  alerte_securite n'a pas de clé étrangère : elle retient une adresse IP, pas un compte.
endlegend
@enduml
