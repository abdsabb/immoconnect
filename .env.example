# ImmoConnect — modèle du fichier .env de production.
# Sur le serveur : cp .env.example .env, puis remplir. Le fichier .env n'est jamais versionné.

# Nom de domaine du site, sans https:// (il doit pointer vers l'adresse IP du serveur)
DOMAINE=immoconnect.example.be

# Base de données — deux mots de passe différents, à générer : openssl rand -hex 24
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Clé de signature des jetons JWT (HS256, 32 octets au moins) — à générer : openssl rand -hex 32
JWT_SECRET=

# Stripe — clés du tableau de bord (mode test pour la démonstration)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook https://<domaine>/api/v1/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Moyens de paiement proposés (carte seule : card)
# STRIPE_MOYENS=card,bancontact

# Boîte de réception de démonstration, sur https://<domaine>/courriels/
COURRIELS_UTILISATEUR=jury
COURRIELS_MOT_DE_PASSE=

# Sécurité des comptes (true par défaut) : à passer à false pour une démonstration sans e-mails
# ACTIVATION_PAR_COURRIEL=true
# DOUBLE_FACTEUR=true

# Sauvegardes — phrase de passe du chiffrement (AES-256), à générer : openssl rand -hex 24
# À conserver AILLEURS que sur le serveur : sans elle, les sauvegardes sont illisibles.
SAUVEGARDE_PASSPHRASE=
# Heure de la sauvegarde nocturne de la base
# SAUVEGARDE_HEURE=03:15

# Mesure d'audience Matomo (https://<domaine>/matomo/) — numéro du site créé à l'installation, en général 1.
# Vide : le site n'envoie rien à Matomo.
MATOMO_SITE_ID=
# Mot de passe de la base de Matomo (par défaut : celui de DB_PASSWORD)
# MATOMO_DB_PASSWORD=

# Expéditeur des e-mails
MAIL_FROM=no-reply@immoconnect.be

# Facultatif — vrai serveur SMTP à la place de la boîte de démonstration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
